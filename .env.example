# Copy to .env and fill in. .env is git-ignored; this file documents the required keys.

# Postgres password for Keycloak's database. NOTE: Postgres only applies this when the data
# volume is first created; changing it later means recreating the volume or ALTER USER.
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin. Only applied the first time Keycloak initialises its database.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Secret the gateway stamps on requests to the internal service (X-Gateway-Key).
# Generate with:  openssl rand -hex 32
GATEWAY_SHARED_KEY=change-me
