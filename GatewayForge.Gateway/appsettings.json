{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://keycloak:8080/realms/gateway-forge",
    "Audience": "gateway-forge-api",
    "RequireHttpsMetadata": false
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "zero-trust-route": {
        "ClusterId": "secure-cluster",
        "AuthorizationPolicy": "SecureAccess",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "api/secure/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "api/{**catch-all}" }
        ]
      },
      "edge-offloaded-route": {
        "ClusterId": "internal-cluster",
        "AuthorizationPolicy": "InternalAccess",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "api/internal/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "api/{**catch-all}" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      }
    },
    "Clusters": {
      "secure-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://secure-service:8080"
          }
        }
      },
      "internal-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://internal-service:8080"
          }
        }
      }
    }
  }
}
