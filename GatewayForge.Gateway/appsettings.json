{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "zero-trust-route": {
        "ClusterId": "secure-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "api/secure/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "api/{**catch-all}" }
        ]
      },
      "edge-offloaded-route": {
        "ClusterId": "internal-cluster",
        "AuthorizationPolicy": "AuthenticatedUser",
        "Match": {
          "Path": "api/internal/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "api/{**catch-all}" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      }
    },
    "Clusters": {
      "secure-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "internal-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}